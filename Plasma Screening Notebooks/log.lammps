# ── Setup ──────────────────────────────────────────────────
units         lj
atom_style    charge
boundary      p p p

# ── Box & Atoms ────────────────────────────────────────────
region        box block 0 10.0 0 10.0 0 10.0
create_box    2 box
Created orthogonal box = (0 0 0) to (10 10 10)
  1 by 1 by 1 MPI processor grid

# Larger overlap distance to prevent particles spawning too close
create_atoms  1 random 150   12345 box overlap 1.0 maxtry 5000
